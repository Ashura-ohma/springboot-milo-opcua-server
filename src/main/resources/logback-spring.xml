<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="myapp"/>
    <property name="LOG_PATH" value="logs/${APP_NAME}"/>
    <!--    %-5level：日志级别（左对齐占 5 位） ,%logger{50}：输出日志的类名（长度 50）。%msg%n：日志内容及换行-->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/info.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch> <!-- 拒绝 ERROR -->
            <onMismatch>ACCEPT</onMismatch> <!-- 接受 INFO/WARN -->
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/info-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- fileNamePattern 结尾使用 .gz，Logback 会在归档时自动开启异步压缩，极大地节省空间-->
            <fileNamePattern>${LOG_PATH}/error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>60</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch> <!-- 仅接受 ERROR -->
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <appender name="ASYNC_INFO" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>1024</queueSize>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="INFO_FILE"/>
    </appender>

    <appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 队列剩余 20% 时开始丢弃，如果你的日志非常重要（不能丢），设为 0。如果性能第一，可以使用默认值-->
        <discardingThreshold>0</discardingThreshold>
        <!-- 内存缓冲队列的大小，根据内存压力调整。在高并发下，调大此值（如 512 或 1024）可以有效缓冲瞬时压力，防止业务线程卡顿-->
        <queueSize>512</queueSize>
        <!-- 如果设为 true，Logback 必须获取当前线程的堆栈信息（行号、方法名等），这非常耗费性能。INFO 日志建议设为 false，ERROR 日志建议设为 true-->
        <includeCallerData>true</includeCallerData>
        <!-- <neverBlock>-->
        <!-- 如果设为 true，当队列满了，直接丢弃新日志，绝不阻塞业务线程，常保持默认 false 以确保日志完整性-->
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <springProfile name="dev,test">
        <!-- 顶级，作用域全局。所有高于或等于该级别的日志都会被记录:TRACE，DEBUG，INFO，WARN，ERROR-->
        <!--   除了上述标准级别，还有两个特殊选项：OFF，ALL，INHERITED / NULL-->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="INFO_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
        <!-- 指定包或类，按需添加。特殊类处理-->
        <logger name="com.yourpackage.mapper" level="DEBUG"/>
    </springProfile>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="ASYNC_INFO"/>
            <appender-ref ref="ASYNC_ERROR"/>
        </root>
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.apache" level="WARN"/>
    </springProfile>
    <!-- =============== 6. 启动验证 =============== -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
</configuration>